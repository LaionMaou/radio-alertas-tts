# =============================================================================
# Radio Alerts TTS — ejemplo de configuración
# Copiar a .env y completar. El archivo .env nunca se versiona.
# =============================================================================

# -----------------------------------------------------------------------------
# AzuraCast (cuenta Streamer/DJ dedicada, sin permisos de administración)
# -----------------------------------------------------------------------------
AZURACAST_BASE_URL=https://radio.kumakuma.fm
AZURACAST_STATION_SHORT_NAME=kuma
# Punto de montaje del DJ dentro de la estación. Casi siempre "/".
AZURACAST_DJ_MOUNT=/
AZURACAST_STREAMER_USER=alert-bot
AZURACAST_STREAMER_PASSWORD=cambiar-esto

# Host y puerto del Streamer/DJ de AzuraCast para el fallback Icecast.
# Desde Docker, usar host.docker.internal si AzuraCast corre en el host.
AZURACAST_DJ_HOST=host.docker.internal
AZURACAST_DJ_PORT=8005
AZURACAST_TLS_VERIFY=true

# Opcional: forzar la URL del WebDJ. Si se deja vacío se construye como
# wss://{AZURACAST_BASE_URL}/webdj/{SHORT_NAME}{DJ_MOUNT}
AZURACAST_WS_URL=

# -----------------------------------------------------------------------------
# Transporte
# -----------------------------------------------------------------------------
# webdj   = WebSocket del WebDJ de AzuraCast (recomendado)
# icecast = cliente de fuente Icecast contra el puerto DJ
TRANSPORT=webdj
# Si el primer transporte falla antes de enviar audio, probar el otro.
ENABLE_ICECAST_FALLBACK=true
# Códec del fallback Icecast: opus (ogg) o mp3
ICECAST_CODEC=opus
# Pausa tras enviar el último byte para que Liquidsoap reproduzca el final.
DRAIN_SECONDS=1.5
# Silencio antes del anuncio. Liquidsoap tarda ~4 s en conmutar al streamer y
# descarta lo ya bufferizado: sin este colchón se pierde el comienzo del texto.
LEAD_IN_SECONDS=5
# Timbre de 4 pings (2 s) después del silencio y antes de la voz. Requiere
# LEAD_IN_SECONDS > 0: si el silencio se desactiva, el timbre también.
CHIME_ENABLED=true
OPEN_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Voz (Kokoro, offline)
# -----------------------------------------------------------------------------
# Disponibles: jf_alpha, jf_gongitsune, jf_nezumi, jf_tebukuro, jm_kumo
TTS_VOICE=jf_alpha
TTS_SPEED=1.0
AUDIO_BITRATE=32k
# Ganancia en dB aplicada al audio final (0 = sin cambios)
AUDIO_GAIN_DB=0

# -----------------------------------------------------------------------------
# Pruebas sin transmisión (genera WAV/WebM pero no toca la radio)
# -----------------------------------------------------------------------------
DRY_RUN=true
# Enviar igualmente la notificación a Discord durante DRY_RUN
NOTIFY_IN_DRY_RUN=false

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# API interna
# -----------------------------------------------------------------------------
# Obligatorio. Cadena larga y aleatoria, por ejemplo:
#   openssl rand -hex 32
API_TOKEN=cambiar-por-un-token-largo
# Dentro de Docker debe escuchar en 0.0.0.0; el puerto solo se publica en
# 127.0.0.1 desde docker-compose.yml.
API_HOST=0.0.0.0
API_PORT=8090

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# En Docker, docker-compose.yml fuerza DATA_DIR=/data (volumen montado).
DATA_DIR=./data
# Si llega una alerta nueva mientras otra espera en cola, descartar la vieja.
LATEST_WINS=true
# Ventana para ignorar alertas repetidas con la misma dedupe_key.
DEDUPE_WINDOW_SECONDS=60
# Largo máximo del texto aceptado (1..600). Un texto sin puntuación se corta.
MAX_TEXT_CHARS=300
# Días que se conservan los artefactos (WAV, WebM, meta.json). 0 = nunca borrar.
ARTIFACT_RETENTION_DAYS=14
# Artista que se muestra en el metadata del stream durante la alerta.
METADATA_ARTIST=Kuma Radio
